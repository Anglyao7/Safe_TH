{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thailand-safety-console",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SAFETY_KV",
      "id": "c6d66cccbf194c6388030c5abf9fca50"
    }
  ]
}
